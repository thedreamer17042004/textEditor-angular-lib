{
  "name": "classic-editor-ws",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng build classic-editor && ng serve",
    "build": "ng build classic-editor && ng build classic-editor-ws",
    "build:lib": "ng build classic-editor",
    "pack:lib": "ng build classic-editor && npm pack ./dist/classic-editor && node -e \"const fs=require('fs');fs.mkdirSync('releases',{recursive:true});fs.renameSync('classic-editor-0.1.0.tgz','releases/classic-editor-0.1.0.tgz');console.log('→ releases/classic-editor-0.1.0.tgz')\"",
    "watch": "ng build classic-editor-ws --watch --configuration development",
    "watch:lib": "ng build classic-editor --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/quill": "^2.0.14",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "typescript": "~5.7.2"
  }
}
